# Copy to .env next to docker-compose.qnap.yml and fill in real values.
# .env is git-ignored. Never commit it; this repo is public.

# Login for the whole app, as username:password. Pick a long, unique password.
BASIC_AUTH=changeme:replace-with-a-long-unique-password

# Comma-separated addresses allowed to sign in. Only used with AUTH_MODE=easyauth
# (Azure), so it can stay empty for the QNAP basic-auth setup.
ALLOWED_EMAILS=
